# BATO Hardened RAG — environment variables
#
# Copy this file to `.env` and fill in the real values:
#   Windows (PowerShell):  Copy-Item .env.example .env
#
# `.env` is gitignored — NEVER commit it. See SETUP.md for where each key
# comes from and which steps need it.

# --- Required for: ingestion, live tests, gate, generation -------------------
# Google AI Studio key (https://aistudio.google.com/apikey). Used for the
# gemini-embedding-001 embeddings, the gemini-2.5-flash-lite input gate, and
# answer generation.
GEMINI_API_KEY=your-gemini-api-key-here

# --- Required for: ingestion, live tests (server-side DB access) -------------
# From your Supabase dashboard: Project Settings -> Data API.
# The service role key is SECRET — server-side only, never in the frontend.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Optional ----------------------------------------------------------------
# Cohere key (https://dashboard.cohere.com/api-keys) for the Rerank v3.5
# stage. If unset, the pipeline safely falls back to cosine-similarity
# ordering — everything still works, ranking is just slightly weaker.
COHERE_API_KEY=

# Generation model override (defaults to gemini-2.5-flash in code).
GEMINI_MODEL=gemini-2.5-flash

# Your deployed frontend origin for CORS, e.g. https://bato.example.com
# Set this as an Edge Function secret before going live (defaults to * for
# local development only).
ALLOWED_ORIGIN=

# --- Tuning knobs (optional; sensible defaults are baked into the code) ------
# General CKD Chatbot (general_education scope):
# VECTOR_SIMILARITY_FLOOR=0.45
# RERANK_THRESHOLD=0.30
# RETRIEVAL_TOP_K=20
# RERANK_TOP_N=4
# FALLBACK_SIMILARITY_THRESHOLD=0.60
#
# LLM Clarification Engine (screening_clarification scope):
# CLARIFY_VECTOR_SIMILARITY_FLOOR=0.50
# CLARIFY_RERANK_THRESHOLD=0.45
# CLARIFY_RETRIEVAL_TOP_K=12
# CLARIFY_RERANK_TOP_N=3
#
# NOTE: CLARIFY_FALLBACK_SIMILARITY is load-bearing whenever COHERE_API_KEY is
# unset, because that is the only threshold left gating answers. It was 0.65,
# which measurement showed to be unreachable — the engine deflected every
# natural-language question. 0.57 is the current default and the deployed
# secret. See supabase/functions/_shared/scopes.ts for the measured
# per-term scores behind that number before changing it.
# CLARIFY_FALLBACK_SIMILARITY=0.57
