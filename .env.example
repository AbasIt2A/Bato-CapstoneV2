# BATO Hardened RAG — environment variables
#
# Copy this file to `.env` and fill in the real values:
#   Windows (PowerShell):  Copy-Item .env.example .env
#
# `.env` is gitignored — NEVER commit it. See SETUP.md for where each key
# comes from and which steps need it.

# --- Required for: ingestion, live tests, generation -------------------------
# Google AI Studio key (https://aistudio.google.com/apikey). Used for
# gemini-embedding-001 embeddings and for answer generation.
#
# QUOTA WARNING. On the free tier, generateContent is capped at 20 requests
# per DAY, counted PER PROJECT PER MODEL. Embeddings are on a separate and
# much larger quota. Exhausting the generation quota does not produce an
# error the user can see — the pipeline degrades to its approved deflection,
# so it looks exactly like "the chatbot refuses every question". Run
# `deno task check:providers` to tell the two apart.
GEMINI_API_KEY=your-gemini-api-key-here

# --- Strongly recommended: input-gate provider -------------------------------
# Groq key (https://console.groq.com/keys). The input gate runs here instead
# of on Gemini, because Groq's free tier is orders of magnitude larger and
# classification does not need a frontier model.
#
# This single variable is what stops every chat message costing TWO Gemini
# requests (gate + generation) out of 20/day. Leave it unset and everything
# still works — the gate falls back to Gemini — but the day's capacity is
# roughly halved.
GROQ_API_KEY=

# --- Required for: ingestion, live tests (server-side DB access) -------------
# From your Supabase dashboard: Project Settings -> Data API.
# The service role key is SECRET — server-side only, never in the frontend.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Optional ----------------------------------------------------------------
# Cohere key (https://dashboard.cohere.com/api-keys) for the Rerank v3.5
# stage. If unset, the pipeline safely falls back to cosine-similarity
# ordering — everything still works, ranking is just slightly weaker.
COHERE_API_KEY=

# Firecrawl key (https://www.firecrawl.dev/app/api-keys) for the source
# scraper — `deno task scrape`. Needed ONLY to fetch new source material into
# scraped/raw/; the running chatbots never touch it, and `deno task clean`
# works offline without it.
FIRECRAWL_API_KEY=
# Override only for a self-hosted Firecrawl. Default: https://api.firecrawl.dev/v2
FIRECRAWL_API_BASE=

# Tavily key (https://app.tavily.com/home) — the scraper's FALLBACK provider.
# Firecrawl plan credits are a hard monthly ceiling; when they run out it
# answers 402 and every remaining source in the run fails. With this set, the
# run continues on Tavily instead of stopping half-fetched.
#
# Tavily has no `onlyMainContent` equivalent, so its raw output carries more
# nav/footer boilerplate and leans harder on `deno task clean`. Check the
# `provider` field in scraped/raw/<id>.meta.json to see which one answered.
TAVILY_API_KEY=
# Override only for a proxy. Default: https://api.tavily.com
TAVILY_API_BASE=
# Force one provider: `tavily` skips Firecrawl entirely (saves a doomed request
# per source once credits are gone); `firecrawl` disables the fallback.
SCRAPE_PROVIDER=

# --- Model overrides ---------------------------------------------------------
# THESE MUST STAY THREE DIFFERENT MODELS. The free-tier quota is per model, so
# each distinct name is its own independent 20/day allowance; pointing two of
# these at one model silently halves capacity. Defaults are in code
# (gemini.ts / gate.ts) and are already distinct — override only with care,
# and re-run `deno task check:providers` afterwards, which warns on collision.
#
# GEMINI_MODEL=gemini-3.5-flash-lite          # general-chat generation
# CLARIFY_GEMINI_MODEL=gemini-3.1-flash-lite  # clarification generation
# GATE_MODEL=gemini-3.5-flash                 # gate, ONLY if Groq is unset
#
# Groq classifier model. Verify it still exists before relying on it: a
# retired name 404s, and the gate fails OPEN, disabling scope and injection
# screening with no visible symptom.
# GROQ_GATE_MODEL=llama-3.1-8b-instant

# --- Answer cache -------------------------------------------------------------
# Replies that pass every guard are cached by query embedding, so repeated
# phrasings of the same question cost no generation call. Requires the
# answer_cache migration; without it every lookup is simply a miss.
#
# Set to false to bypass the cache entirely (e.g. to measure true per-request
# latency, or for an evaluation condition that must observe fresh generation
# on every message).
# ANSWER_CACHE_ENABLED=true
#
# The cache has TWO tiers. Tier 1 is exact match on the normalised question
# (lowercase, collapsed whitespace, no trailing punctuation) — it cannot
# false-hit and needs no embedding call, and it is where the savings come from.
#
# Tier 2 is a similarity backstop, and these are its thresholds. They are set
# from measurement, and the measurement was unflattering: on this corpus,
# embedding similarity does NOT cleanly separate paraphrases from near-misses.
# Same-meaning pairs bottom out at 0.885 while "How do I prevent CKD?" vs
# "How do I TREAT CKD?" reaches 0.925. These values therefore sit ABOVE that
# whole overlap rather than inside it, which makes tier 2 hit rarely by design.
#
# LOWERING THESE TO RAISE THE HIT RATE WALKS INTO THE OVERLAP and starts
# serving answers to questions nobody asked — with no guard behind it, since a
# cached reply passed its checks for a DIFFERENT question. Re-measure first.
# CACHE_HIT_THRESHOLD=0.97
# CLARIFY_CACHE_HIT_THRESHOLD=0.98

# Your deployed frontend origin for CORS, e.g. https://bato.example.com
# Set this as an Edge Function secret before going live (defaults to * for
# local development only).
ALLOWED_ORIGIN=

# --- Tuning knobs (optional; sensible defaults are baked into the code) ------
# VECTOR_SIMILARITY_FLOOR=0.45
# RERANK_THRESHOLD=0.30
