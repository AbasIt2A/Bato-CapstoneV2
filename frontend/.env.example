# Frontend config — both values are PUBLIC (browser-safe).
# Copy this file to frontend/.env and fill in the real values.
#
# One Supabase project backs everything: the general-chat hardened RAG
# pipeline, the Risk Assessment screening/clarify functions (SCORED scoring
# ported from the original capstone build, reused as-is), and the
# SUS/TAM/TiMT evaluation survey.
# Supabase Dashboard → your project → Project Settings → Data API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Form for the SUS / TAM / TiMT feedback surveys (the Feedback page
# links here). Leave empty to show "not ready yet". Public, browser-safe.
VITE_FEEDBACK_FORM_URL=
